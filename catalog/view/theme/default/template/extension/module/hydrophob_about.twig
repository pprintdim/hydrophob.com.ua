<section class="about" id="about">
    <div class="container">
        <div class="about__inner">
            <p class="about__name" data-i18n="about.name">{{ name }}</p>
            <div class="about__content">
                <h2 class="about__title" data-i18n="about.title">{{ title }}</h2>
                <p class="about__descr" data-i18n="about.descr">{{ descr }}</p>
                <button class="about__more btn about-more-open" data-i18n="about.readMore">{{ read_more }}</button>
            </div>
        </div>
    </div>
</section>
