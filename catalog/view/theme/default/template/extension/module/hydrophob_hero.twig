<section class="hero" id="home">
    <div class="container">
        <div class="hero__inner">
            <h1 class="hero__title" data-i18n-html="hero.titleHtml">{{ title_html|raw }}</h1>
        </div>
        <div class="hero__video">
            <img class="hero__video-image" src="{{ poster }}" alt="{{ alt }}" fetchpriority="high">
            <button class="hero__video-play play-btn play-btn-open" data-video="{{ video }}">Play reels</button>
        </div>
    </div>
</section>
