<section class="hero" id="home">
    <div class="container">
        <div class="hero__inner">
            <h1 class="hero__title" data-i18n-html="hero.titleHtml">{{ title_html|raw }}</h1>
        </div>
        {% if slides|length > 1 %}
        <div class="hero__video hero__slider swiper" id="hero-slider">
            <div class="swiper-wrapper">
                {% for slide in slides %}
                <div class="swiper-slide hero__slide">
                    <video class="hero__slide-video" src="{{ slide.video }}" poster="{{ slide.poster }}" muted playsinline loop preload="{{ loop.first ? 'auto' : 'metadata' }}"></video>
                    <button class="hero__video-play play-btn play-btn-open" data-video="{{ slide.video }}">Play reels</button>
                </div>
                {% endfor %}
            </div>
            <div class="swiper-pagination hero__dots"></div>
        </div>
        {% else %}
        <div class="hero__video">
            <img class="hero__video-image" src="{{ poster }}" alt="{{ alt }}" fetchpriority="high">
            <button class="hero__video-play play-btn play-btn-open" data-video="{{ video }}">Play reels</button>
        </div>
        {% endif %}
    </div>
</section>
