<section class="delivery" id="delivery">
    <div class="container">
        <div class="delivery__inner">
            <div class="delivery__content">
                <h2 class="delivery__title" data-i18n-html="delivery.titleHtml">{{ title_html|raw }}</h2>
                <p class="delivery__descr" data-i18n="delivery.descr">{{ descr }}</p>
                <ul class="delivery__list">
                    <li data-i18n="delivery.np">{{ carriers.np.name }}</li>
                    <li data-i18n="delivery.ukr">{{ carriers.ukrposhta.name }}</li>
                    <li data-i18n="delivery.meest">{{ carriers.meest.name }}</li>
                    <li data-i18n="delivery.other">{{ carriers.other.name }}</li>
                    <li data-i18n="delivery.pickup">{{ carriers.pickup.name }}</li>
                    <li data-i18n="delivery.courier">{{ carriers.courier.name }}</li>
                </ul>
            </div>
            <div class="delivery__block">
{% for carrier in carriers %}
                <div class="delivery__item delivery-open" data-delivery="{{ carrier.key }}" role="button" tabindex="0">
                    <img src="{{ carrier.icon }}" alt="{{ carrier.name }}" loading="lazy" decoding="async">
                </div>
{% endfor %}
            </div>
        </div>
    </div>
</section>
