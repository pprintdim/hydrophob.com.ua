<section class="imagesBlock">
    <div class="container">
        <div class="imagesBlock__inner">
            <div class="imagesBlock__block">
                {% for item in items %}
                <div class="imagesBlock__item{% if loop.index0 == 0 %} imagesBlock__item-large{% elseif loop.index0 == 1 %} imagesBlock__item-fill{% endif %}">
                    <img class="imagesBlock__item-image" src="{{ item.tile }}" alt="{{ item.alt }}" loading="lazy" decoding="async">
                    <img class="imagesBlock__item-logo{% if loop.index0 == 2 %} imagesBlock__item-end{% endif %}" src="{{ logo|default('image/hydrophob/imagesBlock/logo.webp') }}" alt="Hydrophob" loading="lazy" decoding="async">
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
