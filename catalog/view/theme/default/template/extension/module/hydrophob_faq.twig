<section class="faq">
    <div class="container">
        <div class="faq__inner">
            <h2 class="faq__title" data-i18n-html="faq.titleHtml">{{ title_html|raw }}</h2>
            <div class="faq__block">
{% for item in items %}
                <div class="faq__item">
                    <h3 class="faq__item-title" data-i18n="faq.q{{ loop.index }}">{{ item.question }}</h3>
                    <p class="faq__item__descr" data-i18n="faq.a{{ loop.index }}">{{ item.answer }}</p>
                </div>
{% endfor %}
            </div>
        </div>
    </div>
</section>
