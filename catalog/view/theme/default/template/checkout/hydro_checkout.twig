<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Оформлення замовлення — Hydrophob</title>
    <meta name="description" content="Оформлення замовлення в інтернет-магазині Hydrophob.">
    <meta name="robots" content="noindex, follow">
    <link rel="icon" type="image/svg+xml" href="image/hydrophob/logo.svg">
    <link rel="icon" type="image/png" href="image/hydrophob/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="catalog/view/theme/default/stylesheet/hydrophob.css?v={{ asset_version }}">
    <script>
        window.HYDRO_CHECKOUT = {
            productsUrl: {{ products_url|json_encode|raw }},
            shippingUrl: {{ shipping_url|json_encode|raw }},
            orderUrl: {{ order_url|json_encode|raw }},
            successUrl: {{ success_url|json_encode|raw }},
            homeUrl: {{ home_url|json_encode|raw }},
            defaultPhoneCountry: {{ default_phone_country|json_encode|raw }}
        };
    </script>
</head>
<body class="body">
    {{ header }}

    <main class="main">
        <section class="checkoutPage">
            <div class="container">
                <div class="cart__inner">
                    <div class="cart__top">
                        <h2 class="cart__title">Оформлення замовлення</h2>
                        <div class="cart__content">

                            <div class="cart__products cart-content" id="checkout-step-products">
                                <div class="cart__products-top cart-top">
                                    <h3 class="cart-name">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
                                            <path d="M23.0622 24.7806C20.8252 24.7806 18.5777 24.7806 16.3407 24.7806C14.1037 24.7806 12.5526 23.5245 12.0989 21.3209C11.2231 16.9883 10.3789 12.6663 9.5137 8.34427C9.36598 7.62039 9.52425 7.74814 8.77508 7.73749C7.56162 7.72685 6.34817 7.74814 5.13472 7.72685C4.1534 7.7162 3.5414 6.85393 3.81575 5.95972C3.99513 5.40617 4.46996 5.02294 5.10306 5.01229C6.90741 5.00165 8.71177 4.991 10.5267 5.01229C11.2653 5.02294 11.7401 5.47004 11.8878 6.21521C12.7847 10.7821 13.6816 15.3382 14.5785 19.9051C14.6524 20.2564 14.7052 20.6077 14.7896 20.959C14.9479 21.5977 15.3699 21.9596 16.0136 22.0341C16.1719 22.0554 16.3301 22.0448 16.4884 22.0448C20.8357 22.0448 25.1936 22.0448 29.541 22.0448C30.765 22.0448 31.1237 21.7574 31.377 20.5438C32.0628 17.3396 32.7487 14.1247 33.424 10.9204C33.6561 9.80268 33.0969 9.10009 31.9573 9.10009C27.6311 9.10009 23.3049 9.10009 18.9786 9.10009C18.7782 9.10009 18.5777 9.10009 18.3877 9.06816C17.7441 8.97235 17.2798 8.42944 17.2587 7.76943C17.2481 7.08813 17.6913 6.52393 18.3455 6.40683C18.5038 6.37489 18.6621 6.36425 18.8204 6.36425C23.2521 6.36425 27.6838 6.3536 32.1156 6.36425C34.5636 6.36425 36.4629 8.36557 36.2308 10.7608C36.1464 11.6656 35.8931 12.5598 35.7032 13.454C35.1334 16.126 34.553 18.8086 33.9727 21.4806C33.5401 23.4713 31.9679 24.7487 29.9525 24.7593C27.6522 24.7913 25.3625 24.7806 23.0622 24.7806Z" fill="white"/>
                                            <path d="M29.3824 34.9897C27.1665 34.979 25.3411 33.1055 25.3516 30.8699C25.3727 28.6238 27.2193 26.7821 29.4351 26.8034C31.651 26.8247 33.4659 28.6664 33.4659 30.8806C33.4659 33.1587 31.6299 35.0003 29.3824 34.9897ZM30.7647 30.8806C30.7541 30.1354 30.1527 29.5393 29.414 29.5499C28.6543 29.5499 28.0529 30.178 28.0634 30.9232C28.074 31.6683 28.6754 32.2645 29.414 32.2645C30.1632 32.2645 30.7752 31.6364 30.7647 30.8806Z" fill="white"/>
                                            <path d="M13.2178 30.8914C13.2178 28.6346 15.0327 26.8036 17.2697 26.8143C19.475 26.8143 21.3004 28.6559 21.311 30.8808C21.311 33.1589 19.5066 35.0005 17.2485 35.0005C15.0327 35.0005 13.2178 33.1589 13.2178 30.8914ZM15.919 30.9021C15.919 31.6579 16.5205 32.2647 17.2697 32.2647C18.0083 32.2647 18.6203 31.6366 18.6097 30.8808C18.5992 30.1462 18.0083 29.5501 17.2697 29.5501C16.5099 29.5501 15.919 30.1356 15.919 30.9021Z" fill="white"/>
                                            <circle cx="35" cy="7" r="4" fill="#1D9CB2"/>
                                        </svg>
                                        <span>Товари в кошику</span>
                                    </h3>
                                    <p class="cart__products-number">0 товарів</p>
                                </div>
                                <div class="cart__products-block"></div>
                                <div class="cart__products-bottom">
                                    <div class="cart__products-total">
                                        <p class="cart__products-total--descr">Загальна сума:</p>
                                        <p class="cart__products-total--descr">0 грн</p>
                                    </div>
                                    <div class="cart__products-total">
                                        <p class="cart__products-total--name">До сплати:</p>
                                        <p class="cart__products-total--name">0 грн</p>
                                    </div>
                                </div>
                            </div>
                            <div class="cart__bottom cart-bottom">
                                <a class="cart__closed btn-2" href="{{ home_url }}">До каталогу</a>
                                <button class="cart__next btn" type="button">Продовжити</button>
                            </div>


                            <div class="cart__data cart-content hide-block">
                                <div class="cart__data-top cart-top">
                                    <h3 class="cart__data-title cart-name">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
                                            <path d="M3.3335 28.3333V33.3333H16.6668V30.1833H6.50016V28.3333C6.50016 27.2667 11.7168 24.8333 16.6668 24.8333C18.2668 24.85 19.8502 25.0667 21.3835 25.4667L23.9168 22.9333C21.5835 22.15 19.1668 21.7167 16.6668 21.6667C12.2168 21.6667 3.3335 23.8833 3.3335 28.3333ZM16.6668 6.66666C12.9835 6.66666 10.0002 9.64999 10.0002 13.3333C10.0002 17.0167 12.9835 20 16.6668 20C20.3502 20 23.3335 17.0167 23.3335 13.3333C23.3335 9.64999 20.3502 6.66666 16.6668 6.66666ZM16.6668 16.6667C14.8335 16.6667 13.3335 15.1833 13.3335 13.3333C13.3335 11.4833 14.8335 9.99999 16.6668 9.99999C18.5002 9.99999 20.0002 11.5 20.0002 13.3333C20.0002 15.1667 18.5168 16.6667 16.6668 16.6667ZM36.1668 22.25L34.5002 23.9167L31.0835 20.5833L32.7502 18.9167C32.9215 18.7487 33.1519 18.6546 33.3918 18.6546C33.6318 18.6546 33.8621 18.7487 34.0335 18.9167L36.1668 21.05C36.5168 21.4 36.5168 21.9833 36.1668 22.3333M20.0002 31.5667L30.1002 21.4667L33.5168 24.8L23.5168 34.9167H20.0002V31.5667Z" fill="white"/>
                                        </svg>
                                        <span>Контактні дані та доставка</span>
                                    </h3>
                                </div>
                                <div class="cart__data-block">
                                    <input class="cart__data-input cart__data-fill" type="text" name="name" placeholder="ПІБ">
                                    <div class="cart__phone">
                                        <select class="cart__phone-country cart__data-select" name="tel-country" aria-label="Код країни" data-default-country="{{ default_phone_country }}"></select>
                                        <input class="cart__data-input" type="tel" name="tel" placeholder="Телефон" autocomplete="tel">
                                        <input type="hidden" name="tel-full">
                                    </div>
                                    <input class="cart__data-input" type="email" name="email" placeholder="Email">
                                </div>
                                <div class="cart__data-block">
                                    <div class="cart__data-deivery cart__data-fill">
                                        <div class="cart__data-deivery--icon">
{% for carrier in carriers %}
                                            <img{{ loop.first ? ' class="active"' : '' }} src="{{ carrier.icon }}" data-carrier="{{ carrier.id }}" alt="{{ carrier.name }}" loading="lazy" decoding="async">
{% endfor %}
                                        </div>
                                        <select name="delivery" class="cart__data-select">
{% for carrier in carriers %}
                                            <option value="{{ carrier.id }}"{{ loop.first ? ' selected' : '' }}>{{ carrier.name }}</option>
{% endfor %}
                                        </select>
                                    </div>
                                    <select name="delivery-type" class="cart__data-select cart__data-fill">
                                        <option value="branch" selected>У відділення</option>
                                        <option value="courier">Кур'єром на адресу</option>
                                    </select>
                                    <div class="cart__suggest cart__data-fill">
                                        <input class="cart__data-input" type="text" name="delivery-city" placeholder="Місто" autocomplete="off">
                                        <ul class="cart__suggest-list"></ul>
                                    </div>
                                    <div class="cart__suggest cart__data-fill">
                                        <input class="cart__data-input" type="text" name="delivery-branch" placeholder="Відділення" autocomplete="off">
                                        <ul class="cart__suggest-list"></ul>
                                    </div>
                                </div>
                            </div>
                            <div class="cart__bottom cart-bottom hide-block">
                                <button class="cart__back btn-2" type="button">Назад</button>
                                <button class="cart__next btn" type="button">Продовжити</button>
                            </div>


                            <div class="cart__check cart-content hide-block">
                                <div class="cart__check-top cart-top">
                                    <h3 class="cart__check-title cart-name">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
                                            <path d="M5.8335 9.16667L8.3335 11.6667L12.5002 7.5M5.8335 19.1667L8.3335 21.6667L12.5002 17.5M5.8335 29.1667L8.3335 31.6667L12.5002 27.5M18.3335 10H33.3335M18.3335 20H33.3335M18.3335 30H33.3335" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        <span>Перевірка даних</span>
                                    </h3>
                                </div>
                                {% if payments|length %}
                                <div class="cart__payment" id="checkout-payments">
                                    <p class="cart__check-title" style="margin-bottom:10px;">Спосіб оплати</p>
                                    {% for code, title in payments %}
                                    <label class="cart__payment-option">
                                        <input type="radio" name="payment_method" value="{{ code }}"{% if loop.first %} checked{% endif %} />
                                        <span>{{ title }}</span>
                                    </label>
                                    {% endfor %}
                                </div>
                                {% endif %}
                                <div class="cart__check-content">
                                    <div class="cart__check-block">
                                        <div class="cart__check-item">
                                            <p class="cart__check-title">Товар</p>
                                            <p class="cart__check-descr"></p>
                                        </div>
                                        <div class="cart__check-item">
                                            <p class="cart__check-title">Кількість</p>
                                            <p class="cart__check-descr"></p>
                                        </div>
                                        <div class="cart__check-item">
                                            <p class="cart__check-title">До оплати</p>
                                            <p class="cart__check-descr"></p>
                                        </div>
                                    </div>
                                    <div class="cart__check-block">
                                        <div class="cart__check-item">
                                            <p class="cart__check-title">Отримувач</p>
                                            <p class="cart__check-descr"></p>
                                        </div>
                                        <div class="cart__check-item">
                                            <p class="cart__check-title">Номер телефону</p>
                                            <p class="cart__check-descr"></p>
                                        </div>
                                        <div class="cart__check-item">
                                            <p class="cart__check-title">Email</p>
                                            <p class="cart__check-descr"></p>
                                        </div>
                                    </div>
                                    <div class="cart__check-block">
                                        <div class="cart__check-item">
                                            <p class="cart__check-title">Спосіб доставки</p>
                                            <p class="cart__check-descr"></p>
                                        </div>
                                        <div class="cart__check-item">
                                            <p class="cart__check-title">Відділення / адреса</p>
                                            <p class="cart__check-descr"></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="cart__bottom cart-bottom hide-block">
                                <button class="cart__back btn-2" type="button">Назад</button>
                                <button class="cart__next btn" type="button" id="checkout-submit">Оформити замовлення</button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    {{ footer }}
    <script src="catalog/view/theme/default/javascript/hydrophob-checkout.js?v={{ asset_version }}"></script>
</body>
</html>
