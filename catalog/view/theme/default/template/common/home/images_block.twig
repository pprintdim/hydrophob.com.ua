<section class="imagesBlock">
    <div class="container">
        <div class="imagesBlock__inner">
            <div class="imagesBlock__block">
                <div class="imagesBlock__item imagesBlock__item-large">
                    <img class="imagesBlock__item-image" src="{{ images.imagesBlock.items[0].tile|default('image/hydrophob/imagesBlock/KOV00626-tile.webp') }}" alt="{{ images.imagesBlock.items[0].alt|default('') }}" loading="lazy" decoding="async">
                    <img class="imagesBlock__item-logo" src="{{ images.imagesBlock.logo|default('image/hydrophob/imagesBlock/logo.webp') }}" alt="Hydrophob" loading="lazy" decoding="async">
                </div>
                <div class="imagesBlock__item imagesBlock__item-fill">
                    <img class="imagesBlock__item-image" src="{{ images.imagesBlock.items[1].tile|default('image/hydrophob/imagesBlock/KOV09659-tile.webp') }}" alt="{{ images.imagesBlock.items[1].alt|default('') }}" loading="lazy" decoding="async">
                    <img class="imagesBlock__item-logo" src="{{ images.imagesBlock.logo|default('image/hydrophob/imagesBlock/logo.webp') }}" alt="Hydrophob" loading="lazy" decoding="async">
                </div>
                <div class="imagesBlock__item">
                    <img class="imagesBlock__item-image" src="{{ images.imagesBlock.items[2].tile|default('image/hydrophob/imagesBlock/frame-canister-tile.webp') }}" alt="{{ images.imagesBlock.items[2].alt|default('') }}" loading="lazy" decoding="async">
                    <img class="imagesBlock__item-logo imagesBlock__item-end" src="{{ images.imagesBlock.logo|default('image/hydrophob/imagesBlock/logo.webp') }}" alt="Hydrophob" loading="lazy" decoding="async">
                </div>
                <div class="imagesBlock__item">
                    <img class="imagesBlock__item-image" src="{{ images.imagesBlock.items[3].tile|default('image/hydrophob/imagesBlock/frame-sprayers-tile.webp') }}" alt="{{ images.imagesBlock.items[3].alt|default('') }}" loading="lazy" decoding="async">
                    <img class="imagesBlock__item-logo" src="{{ images.imagesBlock.logo|default('image/hydrophob/imagesBlock/logo.webp') }}" alt="Hydrophob" loading="lazy" decoding="async">
                </div>
            </div>
        </div>
    </div>
</section>
