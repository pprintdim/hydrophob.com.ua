<section class="reviews">
    <div class="container">
        <div class="reviews__inner">
            <div class="reviews__left">
                <h2 class="reviews__title" data-i18n-html="reviews.titleHtml">Відгуки <span>наших клієнтів</span></h2>
                <div class="reviews__slides"><span>01</span>/12</div>
            </div>
            <div class="reviews__content">
                <div class="reviews__slider">
                    <div class="swiper-wrapper">
{% for reviewItem in images.reviews|default([]) %}
                        <div class="reviews__slide swiper-slide">
                            <div class="reviews__slide-video">
                                <img class="reviews__slide-image" src="{{ reviewItem.poster }}" alt="{{ reviewItem.alt|default('Відгук про Hydrophob') }}" loading="lazy" decoding="async">
                                <button class="reviews__slide-play play-btn play-btn-open" data-video="{{ reviewItem.video }}">Play reels</button>
                            </div>
                            <p class="reviews__slide-message" data-i18n="reviews.message{{ loop.index }}">{{ strings.reviews['message' ~ loop.index].UA|default('') }}</p>
                        </div>
{% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
