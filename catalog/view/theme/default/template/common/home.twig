<!DOCTYPE html>
<html lang="{{ html_lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ meta.title }}</title>
    <meta name="description" content="{{ meta.description }}">
    <meta name="keywords" content="{{ meta.keywords }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ canonical }}">
    <link rel="alternate" hreflang="uk" href="https://hydrophob.net.ua/">
    <link rel="alternate" hreflang="ru" href="https://hydrophob.net.ua/ru">
    <link rel="alternate" hreflang="en" href="https://hydrophob.net.ua/en">
    <link rel="alternate" hreflang="x-default" href="https://hydrophob.net.ua/">

    <meta property="og:type" content="website">
    <meta property="og:locale" content="{{ og_locale }}">
    <meta property="og:site_name" content="{{ site_name }}">
    <meta property="og:title" content="{{ meta.title }}">
    <meta property="og:description" content="{{ meta.description }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:image" content="{{ og_image }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ meta.title }}">
    <meta name="twitter:description" content="{{ meta.description }}">
    <meta name="twitter:image" content="{{ og_image }}">

    {# фавікон — з налаштувань (Налаштування → config_icon); favicon.ico в корені згенерований з нього ж #}
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48">
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96">
    <link rel="apple-touch-icon" href="/favicon-96.png" sizes="96x96">
    <meta name="theme-color" content="#121212">

    <script>window.HYDRO_ANALYTICS = { mode: "{{ analytics.mode }}", ga4: "{{ analytics.ga4 }}", ads: "{{ analytics.ads }}", adsLabel: "{{ analytics.adsLabel }}" };</script>
    {% if analytics.mode == 'production' and analytics.ga4 %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ analytics.ga4 }}"></script>
    <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' });
    gtag('js', new Date());
    gtag('config', '{{ analytics.ga4 }}');
    </script>
    {% endif %}
    <script>window.HYDRO_STRINGS_OVERRIDES = {{ hydro_strings_overrides_json|raw }};</script>
    <script>window.HYDRO_CONTACTS = {{ hydro_contacts_json|raw }};</script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {# шрифти і leaflet не блокують перший рендер: media=print -> all після завантаження #}
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"></noscript>
    <link rel="stylesheet" href="catalog/view/javascript/vendor/swiper-bundle.min.css">
    <link rel="stylesheet" href="catalog/view/javascript/vendor/leaflet.css" media="print" onload="this.media='all'">
    {% if preload_poster %}<link rel="preload" as="image" href="{{ preload_poster }}" fetchpriority="high">{% endif %}
    <link rel="stylesheet" href="catalog/view/theme/default/stylesheet/hydrophob.css?v={{ asset_version }}">
    <script type="application/ld+json">{{ schema_json|raw }}</script>
    <script>window.HYDRO_LANG = "{{ hydro_lang|default('UA') }}";</script>
</head>
<body class="body">
    {% if show_preloader %}
    {# Прелоадер із логотипом: висить, доки не готовий перший кадр hero-відео (або 3 с), мінімум 0.9 с #}
    <div class="hp-preloader" id="hp-preloader" aria-hidden="true">
        <div class="hp-preloader__inner">
            <img class="hp-preloader__logo" src="image/hydrophob/logo.svg" alt="Hydrophob" width="220" height="53">
            <div class="hp-preloader__bar"><i id="hp-preloader-progress"></i></div>
        </div>
    </div>
    <style>
    .hp-preloader{position:fixed;inset:0;z-index:5000;display:flex;align-items:center;justify-content:center;background:#0b0f12;transition:opacity .6s ease,visibility .6s ease}
    .hp-preloader.is-hidden{opacity:0;visibility:hidden;pointer-events:none}
    .hp-preloader__inner{display:flex;flex-direction:column;align-items:center;gap:22px}
    .hp-preloader__logo{width:min(220px,60vw);height:auto;animation:hp-preloader-pulse 1.6s ease-in-out infinite}
    .hp-preloader__bar{width:min(220px,60vw);height:2px;border-radius:2px;background:rgba(255,255,255,.14);overflow:hidden}
    .hp-preloader__bar i{display:block;width:0;height:100%;background:#1ea7e0;transition:width .25s ease}
    @keyframes hp-preloader-pulse{0%,100%{opacity:.75}50%{opacity:1}}
    @media (prefers-reduced-motion: reduce){.hp-preloader__logo{animation:none}}
    </style>
    <script>
    (function () {
        var pre = document.getElementById('hp-preloader'), bar = document.getElementById('hp-preloader-progress');
        if (!pre) return;
        document.documentElement.style.overflow = 'hidden';
        var prog = 0, timer = setInterval(function () { prog = Math.min(90, prog + Math.random() * 8 + 3); bar.style.width = prog + '%'; }, 160);
        var done = false;
        function finish() {
            if (done) return; done = true;
            clearInterval(timer); bar.style.width = '100%';
            setTimeout(function () { pre.classList.add('is-hidden'); document.documentElement.style.overflow = ''; setTimeout(function () { pre.remove(); }, 700); }, 250);
        }
        var minShow = new Promise(function (r) { setTimeout(r, 900); });
        // перше hero-відео вантажиться лише після window.load — тому чекаємо саме його перший кадр
        var videoReady = new Promise(function (r) {
            document.addEventListener('loadeddata', function (e) { if (e.target && e.target.matches && e.target.matches('video.hero__slide-video')) r(); }, true);
            window.addEventListener('load', function () { setTimeout(r, 3000); }, { once: true });
        });
        Promise.all([minShow, videoReady]).then(finish);
        setTimeout(finish, 6000);
    })();
    </script>
    {% endif %}
    {{ header }}

    <main class="main">
        {{ content_top }}
    </main>

    {{ footer }}
    {# попапи в кінці body — щоб порядок заголовків починався з h1 у hero #}
    {{ popup_video }}
    {{ popup_photo }}
    {{ popup_product }}
    {{ popup_about }}
    {{ popup_category }}
    {{ popup_delivery }}
    {{ cart }}
    {{ cookie }}

    <script src="catalog/view/javascript/vendor/leaflet.js"></script>
    <script src="catalog/view/javascript/vendor/swiper-bundle.min.js"></script>
    <script src="catalog/view/theme/default/javascript/hydrophob.js?v={{ asset_version }}"></script>
</body>
</html>
