{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">

          <ul class="nav nav-tabs hydro-tabs hydro-global-langs">
            {% for language in languages %}
            <li{% if loop.first %} class="active"{% endif %}><a href="#" data-lang="{{ language.language_id }}">{{ language.name }}</a></li>
            {% endfor %}
          </ul>

          <div id="images-items">
          {% for item in items %}
          {% set idx = loop.index0 %}
          <div class="hydro-card images-item hydro-row--collapsed">
            <div class="hydro-row__toggle images-item-head">
              <i class="fa fa-chevron-right hydro-row__chevron"></i>
              <span class="hydro-card__title" style="margin:0;">{{ entry_item }} <span class="images-item-num">{{ loop.index }}</span></span>
              <span class="hydro-row__preview">{{ item.alt[2] is defined ? item.alt[2] : '' }}</span>
              <button type="button" class="btn btn-danger btn-xs images-item-remove" title="Видалити"><i class="fa fa-minus-circle"></i></button>
            </div>
            <div class="hydro-row__body images-item-line">
              <span class="media-tile">
                <a href="" id="thumb-item{{ idx }}" data-toggle="image" class="img-thumbnail"><img src="{{ item.thumb_tile }}" alt="" data-placeholder="{{ placeholder }}" style="width:64px;height:64px;object-fit:cover;" /></a>
                <input type="hidden" name="module_hydrophob_images_block_items[{{ idx }}][tile]" value="{{ item.tile }}" id="input-item{{ idx }}" />
                <a href="" data-toggle="video" data-video-input="input-item-video{{ idx }}" class="media-tile__play {% if item.video %}media-tile__play--on{% else %}media-tile__play--off{% endif %}" title="{{ item.video ?: 'Прикріпити відео (гратиме при скролі)' }}"><i class="fa fa-play"></i></a>
                <button type="button" class="media-tile__clear-video"{% if not item.video %} style="display:none;"{% endif %} title="Прибрати відео">&times;</button>
                <input type="hidden" data-role="video" name="module_hydrophob_images_block_items[{{ idx }}][video]" value="{{ item.video }}" id="input-item-video{{ idx }}" />
              </span>
              <div class="images-item-alt">
                {% for language in languages %}
                <div class="lang-field lang-field-{{ language.language_id }}"{% if not loop.first %} style="display:none;"{% endif %}>
                  <input type="text" name="module_hydrophob_images_block_items[{{ idx }}][alt][{{ language.language_id }}]" value="{{ item.alt[language.language_id] is defined ? item.alt[language.language_id] : '' }}" placeholder="{{ entry_alt }}" class="form-control input-sm" />
                </div>
                {% endfor %}
              </div>
            </div>
          </div>
          {% endfor %}
          </div>

          <div class="form-group" style="margin:0 0 14px;">
            <button type="button" id="images-item-add" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> Додати плитку</button>
          </div>

          <div class="hydro-card">
            <div class="hydro-card__title">{{ entry_logo }}</div>
            <a href="" id="thumb-logo" data-toggle="image" class="img-thumbnail">
              <img src="{{ thumb_logo }}" alt="" data-placeholder="{{ placeholder }}" style="width:84px;height:84px;object-fit:cover;" />
            </a>
            <input type="hidden" name="module_hydrophob_images_block_logo" value="{{ logo }}" id="input-logo" />
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_hydrophob_images_block_status" id="input-status" class="form-control">
                <option value="1" {% if status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<style>
.hydro-card { background: linear-gradient(180deg, #fff 0%, #f8fbff 100%); border: 1px solid #dfe6f1; border-radius: 10px; margin-bottom: 14px; padding: 14px; }
.hydro-card__title { color: #36506b; font-size: 12px; font-weight: 700; letter-spacing: .04em; margin-bottom: 9px; text-transform: uppercase; }
.hydro-tabs { border-bottom: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.hydro-tabs > li { float: none; margin: 0; }
.hydro-tabs > li > a { background: #f7fafc; border: 1px solid #d9e4ef; border-radius: 999px; color: #4b627b; padding: 6px 10px; }
.hydro-tabs > li.active > a, .hydro-tabs > li.active > a:hover, .hydro-tabs > li.active > a:focus { background: #e9f4ff; border-color: #acd1f1; color: #1f5d95; }
.hydro-tab-content .form-control { border-color: #d7e3ef; border-radius: 10px; box-shadow: none; }
.hydro-global-langs { margin-bottom: 16px; }
</style>


<script type="text/javascript"><!--
var imagesLangs = [{% for language in languages %}{id: {{ language.language_id }}, name: '{{ language.name|escape('js') }}'}{% if not loop.last %},{% endif %}{% endfor %}];
var imagesActiveLang = String(imagesLangs.length ? imagesLangs[0].id : '');

// Глобальний перемикач мов: показує поля лише активної мови у ВСІЙ формі (включно з новими рядами)
document.querySelectorAll('.hydro-global-langs a[data-lang]').forEach(function (a) {
  a.addEventListener('click', function (e) {
    e.preventDefault();
    imagesActiveLang = this.dataset.lang;
    document.querySelectorAll('.hydro-global-langs li').forEach(function (li) { li.classList.remove('active'); });
    this.parentNode.classList.add('active');
    document.querySelectorAll('.lang-field').forEach(function (el) {
      el.style.display = el.classList.contains('lang-field-' + imagesActiveLang) ? '' : 'none';
    });
  });
});

// Репітер плиток: додавання нового ряду (порожні поля) і видалення; name-індекси
// перенумеровуються при сабміті не потрібно — PHP приймає будь-які ключі, головне унікальність.
var imagesRowIndex = {{ items|length }};
document.getElementById('images-item-add').addEventListener('click', function () {
  var wrap = document.getElementById('images-items');
  var idx = imagesRowIndex++;
  var card = document.createElement('div');
  card.className = 'hydro-card images-item';
  var fields = '';
  imagesLangs.forEach(function (l) {
    var vis = String(l.id) === imagesActiveLang ? '' : ' style="display:none;"';
    fields += '<div class="lang-field lang-field-' + l.id + '"' + vis + '>' +
      '<input type="text" name="module_hydrophob_images_block_items[' + idx + '][alt][' + l.id + ']" value="" placeholder="{{ entry_alt|escape('js') }}" class="form-control input-sm" /></div>';
  });
  card.innerHTML =
    '<div class="hydro-row__toggle images-item-head"><i class="fa fa-chevron-down hydro-row__chevron"></i><span class="hydro-card__title" style="margin:0;">{{ entry_item|escape('js') }} <span class="images-item-num"></span></span><span class="hydro-row__preview"></span><button type="button" class="btn btn-danger btn-xs images-item-remove"><i class="fa fa-minus-circle"></i></button></div>' +
    '<div class="hydro-row__body images-item-line">' +
    '<span class="media-tile">' +
    '<a href="" id="thumb-item' + idx + '" data-toggle="image" class="img-thumbnail"><img src="{{ placeholder }}" alt="" data-placeholder="{{ placeholder }}" style="width:64px;height:64px;object-fit:cover;" /></a>' +
    '<input type="hidden" name="module_hydrophob_images_block_items[' + idx + '][tile]" value="" id="input-item' + idx + '" />' +
    '<a href="" data-toggle="video" data-video-input="input-item-video' + idx + '" class="media-tile__play media-tile__play--off" title="Прикріпити відео"><i class="fa fa-play"></i></a>' +
    '<button type="button" class="media-tile__clear-video" style="display:none;">&times;</button>' +
    '<input type="hidden" data-role="video" name="module_hydrophob_images_block_items[' + idx + '][video]" value="" id="input-item-video' + idx + '" /></span>' +
    '<div class="images-item-alt">' + fields + '</div></div>';
  wrap.appendChild(card);
  renumberImages();
});
document.getElementById('images-items').addEventListener('click', function (e) {
  if (e.target.closest('.images-item-remove') || e.target.closest('a[data-toggle]')) return;
  var head = e.target.closest('.hydro-row__toggle');
  if (head) head.closest('.images-item').classList.toggle('hydro-row--collapsed');
});

document.getElementById('images-items').addEventListener('click', function (e) {
  var btn = e.target.closest('.images-item-remove');
  if (btn) { btn.closest('.images-item').remove(); renumberImages(); }
});
function renumberImages() {
  document.querySelectorAll('#images-items .images-item-num').forEach(function (el, i) { el.textContent = i + 1; });
}
//--></script>


<style>
.images-item { padding: 10px 12px; }
.images-item .hydro-row__body.images-item-line { align-items: center; display: flex; gap: 12px; padding-top: 10px; }
.images-item .images-item-alt { flex: 1; min-width: 0; }
.images-item .media-tile__play--off { bottom: 4px; height: 20px; right: 4px; width: 20px; font-size: 11px; }
.images-item .media-tile__play--on { bottom: 4px; height: 22px; right: 4px; width: 22px; font-size: 12px; }
.images-item .hydro-row__toggle { align-items: center; cursor: pointer; display: flex; gap: 10px; user-select: none; }
.images-item .images-item-remove { margin-left: auto; }
.images-item .hydro-row__chevron { color: #7f96ad; font-size: 12px; transition: transform .18s ease; }
.images-item:not(.hydro-row--collapsed) .hydro-row__chevron { transform: rotate(90deg); }
.images-item .hydro-row__preview { color: #8fa2b5; flex: 1; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.images-item.hydro-row--collapsed .hydro-row__body { display: none; }
</style>

<style>
.media-tile { display: inline-block; position: relative; }
.media-tile .img-thumbnail { display: block; margin: 0; padding: 2px; }
.media-tile__play { align-items: center; border-radius: 50%; color: #fff; cursor: pointer; display: flex; font-size: 13px; justify-content: center; position: absolute; z-index: 2; }
.media-tile__play--off { background: rgba(18,18,18,.45); bottom: 7px; height: 24px; right: 7px; width: 24px; }
.media-tile__play--on { background: #1D9CB2; bottom: 7px; font-size: 14px; height: 28px; right: 7px; width: 28px; }
.media-tile__play--on:hover, .media-tile__play--off:hover { background: #1D9CB2; }
.media-tile__play i { margin-left: 2px; }
.media-tile__clear-video { background: #fff; border: 1px solid #e3b3b3; border-radius: 50%; color: #c66; cursor: pointer; font-size: 13px; height: 22px; line-height: 1; padding: 0; position: absolute; right: -7px; top: -7px; width: 22px; z-index: 3; }
</style>
<script type="text/javascript"><!--
function syncMediaTile(tile) {
  var input = tile.querySelector('input[data-role=video]');
  var play = tile.querySelector('.media-tile__play');
  var clear = tile.querySelector('.media-tile__clear-video');
  var has = !!input.value;
  play.classList.toggle('media-tile__play--on', has);
  play.classList.toggle('media-tile__play--off', !has);
  play.title = input.value || 'Прикріпити відео';
  if (clear) clear.style.display = has ? '' : 'none';
}
$(document).on('click', '.media-tile__clear-video', function () {
  var tile = this.closest('.media-tile');
  tile.querySelector('input[data-role=video]').value = '';
  syncMediaTile(tile);
});
$(document).on('hidden.bs.modal', '#modal-image', function () {
  document.querySelectorAll('.media-tile').forEach(syncMediaTile);
});
$(document).on('click', 'a[data-toggle="video"]', function (e) {
  e.preventDefault();
  var targetId = $(this).data('video-input');
  $('#modal-image').remove();
  $.ajax({
    url: 'index.php?route=common/filemanager&user_token={{ user_token }}&target=' + targetId + '&filter_type=video',
    dataType: 'html',
    success: function (html) {
      $('body').append('<div id="modal-image" class="modal">' + html + '</div>');
      $('#modal-image').modal('show');
    }
  });
});
//--></script>
{{ footer }}
