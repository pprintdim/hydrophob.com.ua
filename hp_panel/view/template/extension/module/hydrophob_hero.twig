{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">

          <ul class="nav nav-tabs hydro-tabs hydro-global-langs">
            {% for language in languages %}
            <li{% if loop.first %} class="active"{% endif %}><a href="#" data-lang="{{ language.language_id }}">{{ language.name }}</a></li>
            {% endfor %}
          </ul>

          <div class="hydro-card">
            <div class="hydro-card__title">{{ entry_title_html }}</div>
            {% for language in languages %}
            <div class="lang-field lang-field-{{ language.language_id }}"{% if not loop.first %} style="display:none;"{% endif %}>
              <input type="text" name="module_hydrophob_hero_title_html[{{ language.language_id }}]" value="{{ title_html[language.language_id] is defined ? title_html[language.language_id] : '' }}" placeholder="{{ entry_title_html }}" class="form-control" />
            </div>
            {% endfor %}
            <p class="help-block">{{ help_title_html }}</p>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_alt }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_hydrophob_hero_alt" value="{{ alt }}" placeholder="{{ entry_alt }}" class="form-control" />
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_video }}</label>
            <div class="col-sm-10">
              <span class="hero-video-note" style="color:#8fa2b5;font-size:12px;">Відео прикріплюється на постері нижче (кнопка ▶)</span>
              <p class="help-block">{{ help_video }}</p>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_poster }}</label>
            <div class="col-sm-10">
              <span class="media-tile">
                <a href="" id="thumb-poster" data-toggle="image" class="img-thumbnail"><img src="{{ thumb_poster }}" alt="" data-placeholder="{{ placeholder }}" /></a>
                <input type="hidden" name="module_hydrophob_hero_poster" value="{{ poster }}" id="input-poster" />
                <a href="" data-toggle="video" data-video-input="input-hero-video" class="media-tile__play {% if video %}media-tile__play--on{% else %}media-tile__play--off{% endif %}" title="{{ video ?: 'Прикріпити відео' }}"><i class="fa fa-play"></i></a>
                <button type="button" class="media-tile__clear-video"{% if not video %} style="display:none;"{% endif %} title="Прибрати відео">&times;</button>
                <input type="hidden" data-role="video" name="module_hydrophob_hero_video" value="{{ video }}" id="input-hero-video" />
              </span>
              <style>
.media-tile { display: inline-block; position: relative; }
.media-tile .img-thumbnail { display: block; margin: 0; padding: 2px; }
.media-tile .img-thumbnail img { display: block; height: 96px; object-fit: cover; width: 96px; }
.media-tile__play { align-items: center; border-radius: 50%; color: #fff; cursor: pointer; display: flex; font-size: 13px; justify-content: center; position: absolute; z-index: 2; }
.media-tile__play--off { background: rgba(18,18,18,.45); bottom: 7px; height: 24px; right: 7px; width: 24px; }
.media-tile__play--on { background: #1D9CB2; bottom: 7px; font-size: 14px; height: 28px; right: 7px; width: 28px; }
.media-tile__play--on:hover, .media-tile__play--off:hover { background: #1D9CB2; color: #fff; }
.media-tile__play i { margin-left: 2px; }
.media-tile__clear-video { background: #fff; border: 1px solid #e3b3b3; border-radius: 50%; color: #c66; cursor: pointer; font-size: 13px; height: 22px; line-height: 1; padding: 0; position: absolute; right: -7px; top: -7px; width: 22px; z-index: 3; }
              </style>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_hydrophob_hero_status" id="input-status" class="form-control">
                <option value="1" {% if status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<style>
.hydro-card { background: linear-gradient(180deg, #fff 0%, #f8fbff 100%); border: 1px solid #dfe6f1; border-radius: 10px; margin-bottom: 14px; padding: 14px; }
.hydro-card__title { color: #36506b; font-size: 12px; font-weight: 700; letter-spacing: .04em; margin-bottom: 9px; text-transform: uppercase; }
.hydro-tabs { border-bottom: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.hydro-tabs > li { float: none; margin: 0; }
.hydro-tabs > li > a { background: #f7fafc; border: 1px solid #d9e4ef; border-radius: 999px; color: #4b627b; padding: 6px 10px; }
.hydro-tabs > li.active > a, .hydro-tabs > li.active > a:hover, .hydro-tabs > li.active > a:focus { background: #e9f4ff; border-color: #acd1f1; color: #1f5d95; }
.hydro-tab-content .form-control { border-color: #d7e3ef; border-radius: 10px; box-shadow: none; }
.hydro-repeater { background: #f7f9fc; border: 1px solid #dfe6f1; border-radius: 10px; padding: 14px; margin-bottom: 14px; }
.hydro-repeater__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 10px; }
.hydro-repeater__head h4 { margin: 0; }
.hydro-row { background: #fff; border: 1px solid #e4eaf3; border-radius: 8px; margin-bottom: 8px; padding: 12px; }
.hydro-row__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 8px; }
.hydro-row__lang { color: #5f6f86; display: block; font-size: 11px; font-weight: 600; line-height: 1; margin-bottom: 4px; text-transform: uppercase; }
.hydro-global-langs { margin-bottom: 16px; }
</style>


<script type="text/javascript"><!--

// Глобальний перемикач мов: показує поля лише активної мови у ВСІЙ формі
document.querySelectorAll('.hydro-global-langs a[data-lang]').forEach(function (a) {
  a.addEventListener('click', function (e) {
    e.preventDefault();
    var lang = this.dataset.lang;
    document.querySelectorAll('.hydro-global-langs li').forEach(function (li) { li.classList.remove('active'); });
    this.parentNode.classList.add('active');
    document.querySelectorAll('.lang-field').forEach(function (el) {
      el.style.display = el.classList.contains('lang-field-' + lang) ? '' : 'none';
    });
  });
});

function syncMediaTile(tile) {
  var input = tile.querySelector('input[data-role=video]');
  var play = tile.querySelector('.media-tile__play');
  var clear = tile.querySelector('.media-tile__clear-video');
  var has = !!input.value;
  play.classList.toggle('media-tile__play--on', has);
  play.classList.toggle('media-tile__play--off', !has);
  play.title = input.value || 'Прикріпити відео';
  if (clear) clear.style.display = has ? '' : 'none';
}
$(document).on('click', '.media-tile__clear-video', function () {
  var tile = this.closest('.media-tile');
  tile.querySelector('input[data-role=video]').value = '';
  syncMediaTile(tile);
});
$(document).on('hidden.bs.modal', '#modal-image', function () {
  document.querySelectorAll('.media-tile').forEach(function (tile) {
    syncMediaTile(tile);
    // Автопостер: якщо відео вибране, а постера нема — генеруємо кадр з відео (ffmpeg, детерміновано)
    var vid = tile.querySelector('input[data-role=video]');
    var posterInput = tile.querySelector('input[type=hidden]:not([data-role])');
    var img = tile.querySelector('.img-thumbnail img');
    if (vid.value && posterInput && !posterInput.value) {
      $.getJSON('index.php?route=common/video_poster&user_token={{ user_token }}&video=' + encodeURIComponent(vid.value), function (r) {
        if (r && r.poster) {
          posterInput.value = r.poster;
          if (img && r.thumb) img.src = r.thumb;
        }
      });
    }
  });
});

$(document).on('click', 'a[data-toggle="video"]', function (e) {
  e.preventDefault();
  var targetId = $(this).data('video-input');
  $('#modal-image').remove();
  $.ajax({
    url: 'index.php?route=common/filemanager&user_token={{ user_token }}&target=' + targetId + '&filter_type=video',
    dataType: 'html',
    success: function (html) {
      $('body').append('<div id="modal-image" class="modal">' + html + '</div>');
      $('#modal-image').modal('show');
    }
  });
});
//--></script>
{{ footer }}
