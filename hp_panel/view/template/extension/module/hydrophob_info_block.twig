{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <ul class="nav nav-tabs" id="info-block-tab-select">
      {% for tabKey, tab in tabs %}
      <li{% if loop.first %} class="active"{% endif %}><a href="#pane-{{ tabKey }}" data-toggle="tab">{{ tab.label }}</a></li>
      {% endfor %}
    </ul>

    <div class="tab-content" style="padding-top:15px;">
      <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module">
        {% for tabKey, tab in tabs %}
        <div class="tab-pane{% if loop.first %} active{% endif %}" id="pane-{{ tabKey }}">
          <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title">{{ tab.label }}</h3></div>
            <div class="panel-body">

              <div class="hydro-card">
                <div class="hydro-card__title">{{ entry_tab_title }}</div>
                <ul class="nav nav-tabs hydro-tabs">
                  {% for language in languages %}
                  <li{% if loop.first %} class="active"{% endif %}><a href="#{{ tabKey }}-title{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
                  {% endfor %}
                </ul>
                <div class="tab-content hydro-tab-content">
                  {% for language in languages %}
                  <div class="tab-pane{% if loop.first %} active{% endif %}" id="{{ tabKey }}-title{{ language.language_id }}">
                    <input type="text" name="module_hydrophob_info_block_tabs[{{ tabKey }}][tab_title][{{ language.language_id }}]" value="{{ tab.tab_title[language.language_id] is defined ? tab.tab_title[language.language_id] : '' }}" class="form-control" />
                  </div>
                  {% endfor %}
                </div>
              </div>

              <div class="hydro-card">
                <div class="hydro-card__title">{{ entry_subtitle }}</div>
                <ul class="nav nav-tabs hydro-tabs">
                  {% for language in languages %}
                  <li{% if loop.first %} class="active"{% endif %}><a href="#{{ tabKey }}-subtitle{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
                  {% endfor %}
                </ul>
                <div class="tab-content hydro-tab-content">
                  {% for language in languages %}
                  <div class="tab-pane{% if loop.first %} active{% endif %}" id="{{ tabKey }}-subtitle{{ language.language_id }}">
                    <input type="text" name="module_hydrophob_info_block_tabs[{{ tabKey }}][subtitle][{{ language.language_id }}]" value="{{ tab.subtitle[language.language_id] is defined ? tab.subtitle[language.language_id] : '' }}" class="form-control" />
                  </div>
                  {% endfor %}
                </div>
              </div>

              <div class="hydro-card">
                <div class="hydro-card__title">{{ entry_media }}</div>
                <div class="row">
                  <div class="col-sm-3">
                    <a href="" id="thumb-{{ tabKey }}-poster" data-toggle="image" class="img-thumbnail">
                      <img src="{{ tab.thumb_poster }}" alt="" data-placeholder="{{ placeholder }}" style="max-width:160px;" />
                    </a>
                    <input type="hidden" name="module_hydrophob_info_block_tabs[{{ tabKey }}][poster]" value="{{ tab.poster }}" id="input-{{ tabKey }}-poster" />
                  </div>
                  <div class="col-sm-9">
                    <div class="form-group">
                      <label>{{ entry_video }}</label>
                      <input type="text" name="module_hydrophob_info_block_tabs[{{ tabKey }}][video]" value="{{ tab.video }}" class="form-control" />
                    </div>
                    <label>{{ entry_alt }}</label>
                    <ul class="nav nav-tabs hydro-tabs">
                      {% for language in languages %}
                      <li{% if loop.first %} class="active"{% endif %}><a href="#{{ tabKey }}-alt{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
                      {% endfor %}
                    </ul>
                    <div class="tab-content hydro-tab-content">
                      {% for language in languages %}
                      <div class="tab-pane{% if loop.first %} active{% endif %}" id="{{ tabKey }}-alt{{ language.language_id }}">
                        <input type="text" name="module_hydrophob_info_block_tabs[{{ tabKey }}][alt][{{ language.language_id }}]" value="{{ tab.alt[language.language_id] is defined ? tab.alt[language.language_id] : '' }}" class="form-control" />
                      </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </div>

              <div class="hydro-repeater">
                <div class="hydro-repeater__head">
                  <h4>{{ entry_blocks }}</h4>
                  <button type="button" class="btn btn-primary btn-sm btn-add-block" data-tab="{{ tabKey }}" data-next="{{ tab.next_block_index }}"><i class="fa fa-plus-circle"></i> {{ entry_add_block }}</button>
                </div>
                <div id="blocks-{{ tabKey }}">
                  {% for bKey, block in tab.blocks %}
                  <div class="hydro-row" id="block-{{ tabKey }}-{{ bKey }}">
                    <div class="hydro-row__head">
                      <strong>{{ entry_block }}</strong>
                      <button type="button" class="btn btn-danger btn-sm btn-remove-block"><i class="fa fa-minus-circle"></i></button>
                    </div>
                    <div class="hydro-card">
                      <div class="hydro-card__title">{{ entry_block_title }}</div>
                      <ul class="nav nav-tabs hydro-tabs">
                        {% for language in languages %}
                        <li{% if loop.first %} class="active"{% endif %}><a href="#{{ tabKey }}-b{{ bKey }}-title{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
                        {% endfor %}
                      </ul>
                      <div class="tab-content hydro-tab-content">
                        {% for language in languages %}
                        <div class="tab-pane{% if loop.first %} active{% endif %}" id="{{ tabKey }}-b{{ bKey }}-title{{ language.language_id }}">
                          <input type="text" name="module_hydrophob_info_block_tabs[{{ tabKey }}][blocks][{{ bKey }}][title][{{ language.language_id }}]" value="{{ block.title[language.language_id] is defined ? block.title[language.language_id] : '' }}" class="form-control" />
                        </div>
                        {% endfor %}
                      </div>
                    </div>
                    <div class="hydro-card">
                      <div class="hydro-card__title">{{ entry_block_html }}</div>
                      <ul class="nav nav-tabs hydro-tabs">
                        {% for language in languages %}
                        <li{% if loop.first %} class="active"{% endif %}><a href="#{{ tabKey }}-b{{ bKey }}-html{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
                        {% endfor %}
                      </ul>
                      <div class="tab-content hydro-tab-content">
                        {% for language in languages %}
                        <div class="tab-pane{% if loop.first %} active{% endif %}" id="{{ tabKey }}-b{{ bKey }}-html{{ language.language_id }}">
                          <textarea name="module_hydrophob_info_block_tabs[{{ tabKey }}][blocks][{{ bKey }}][html][{{ language.language_id }}]" rows="5" data-toggle="summernote" class="form-control">{{ block.html[language.language_id] is defined ? block.html[language.language_id] : '' }}</textarea>
                        </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                  {% endfor %}
                </div>
              </div>

            </div>
          </div>
        </div>
        {% endfor %}

        <div class="form-group">
          <label for="input-status">{{ entry_status }}</label>
          <select name="module_hydrophob_info_block_status" id="input-status" class="form-control" style="width:auto;display:inline-block;">
            <option value="1" {% if status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
            <option value="0" {% if not status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
          </select>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
var infoBlockLangs = [
{% for language in languages %}
  { id: {{ language.language_id }}, name: '{{ language.name|escape('js') }}' }{% if not loop.last %},{% endif %}
{% endfor %}
];

function infoBlockLangTabs(prefix, tabKey, idx, kind) {
  var tabsHtml = '<ul class="nav nav-tabs hydro-tabs">';
  var contentHtml = '<div class="tab-content hydro-tab-content">';
  for (var i = 0; i < infoBlockLangs.length; i++) {
    var active = i === 0 ? ' active' : '';
    tabsHtml += '<li class="' + active.trim() + '"><a href="#' + prefix + infoBlockLangs[i].id + '" data-toggle="tab">' + infoBlockLangs[i].name + '</a></li>';
    var field = kind === 'html'
      ? '<textarea name="module_hydrophob_info_block_tabs[' + tabKey + '][blocks][' + idx + '][html][' + infoBlockLangs[i].id + ']" rows="5" class="form-control"></textarea>'
      : '<input type="text" name="module_hydrophob_info_block_tabs[' + tabKey + '][blocks][' + idx + '][title][' + infoBlockLangs[i].id + ']" class="form-control" />';
    contentHtml += '<div class="tab-pane' + active + '" id="' + prefix + infoBlockLangs[i].id + '">' + field + '</div>';
  }
  tabsHtml += '</ul>';
  contentHtml += '</div>';
  return tabsHtml + contentHtml;
}

document.querySelectorAll('.btn-add-block').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var tabKey = btn.dataset.tab;
    var idx = parseInt(btn.dataset.next, 10);
    var list = document.getElementById('blocks-' + tabKey);
    var row = document.createElement('div');
    row.className = 'hydro-row';
    row.id = 'block-' + tabKey + '-' + idx;

    row.innerHTML =
      '<div class="hydro-row__head"><strong>{{ entry_block|escape('js') }}</strong><button type="button" class="btn btn-danger btn-sm btn-remove-block"><i class="fa fa-minus-circle"></i></button></div>' +
      '<div class="hydro-card"><div class="hydro-card__title">{{ entry_block_title|escape('js') }}</div>' + infoBlockLangTabs(tabKey + '-b' + idx + '-title', tabKey, idx, 'title') + '</div>' +
      '<div class="hydro-card"><div class="hydro-card__title">{{ entry_block_html|escape('js') }}</div>' + infoBlockLangTabs(tabKey + '-b' + idx + '-html', tabKey, idx, 'html') + '</div>';

    list.appendChild(row);
    btn.dataset.next = idx + 1;

    row.querySelector('.btn-remove-block').addEventListener('click', function() {
      row.parentNode.removeChild(row);
    });
  });
});

document.querySelectorAll('.btn-remove-block').forEach(function(btn) {
  btn.addEventListener('click', function() {
    btn.closest('.hydro-row').remove();
  });
});
</script>

<style>
.hydro-card { background: linear-gradient(180deg, #fff 0%, #f8fbff 100%); border: 1px solid #dfe6f1; border-radius: 10px; margin-bottom: 14px; padding: 14px; }
.hydro-card__title { color: #36506b; font-size: 12px; font-weight: 700; letter-spacing: .04em; margin-bottom: 9px; text-transform: uppercase; }
.hydro-tabs { border-bottom: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.hydro-tabs > li { float: none; margin: 0; }
.hydro-tabs > li > a { background: #f7fafc; border: 1px solid #d9e4ef; border-radius: 999px; color: #4b627b; padding: 6px 10px; }
.hydro-tabs > li.active > a, .hydro-tabs > li.active > a:hover, .hydro-tabs > li.active > a:focus { background: #e9f4ff; border-color: #acd1f1; color: #1f5d95; }
.hydro-tab-content .form-control { border-color: #d7e3ef; border-radius: 10px; box-shadow: none; }
.hydro-repeater { background: #f7f9fc; border: 1px solid #dfe6f1; border-radius: 10px; padding: 14px; margin-bottom: 14px; }
.hydro-repeater__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 10px; }
.hydro-repeater__head h4 { margin: 0; }
.hydro-row { background: #fff; border: 1px solid #e4eaf3; border-radius: 8px; margin-bottom: 10px; padding: 12px; }
.hydro-row__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 8px; }
</style>

<script type="text/javascript" src="view/javascript/summernote/summernote.min.js"></script>
<link href="view/javascript/summernote/summernote.min.css" rel="stylesheet" />
<script type="text/javascript" src="view/javascript/summernote/summernote-image-attributes.js"></script>
<script type="text/javascript" src="view/javascript/summernote/opencart.js"></script>

{{ footer }}
