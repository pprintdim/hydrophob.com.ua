{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_help }}</div>

    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module">
      <div class="hydro-repeater">
        <div class="hydro-repeater__head">
          <h4>{{ entry_rows }}</h4>
          <button type="button" class="btn btn-primary btn-sm" id="btn-add-row"><i class="fa fa-plus-circle"></i> {{ entry_add_row }}</button>
        </div>
        <div id="rows-list">
          {% for row in rows %}
          <div class="hydro-row hydro-row--collapsed" id="row-{{ row.index }}">
            <div class="hydro-row__head hydro-row__toggle">
              <i class="fa fa-chevron-right hydro-row__chevron"></i>
              <strong>{{ entry_row }} #{{ loop.index }}</strong>
              <span class="hydro-row__preview">{{ row.product_name|default('') }}</span>
              <button type="button" class="btn btn-danger btn-sm btn-remove-row"><i class="fa fa-minus-circle"></i></button>
            </div>
            <div class="hydro-row__body">
            <div class="row">
              <div class="col-sm-4">
                <div class="form-group">
                  <label>{{ entry_category }}</label>
                  <select name="module_hydrophob_info_block_rows[{{ row.index }}][category_id]" class="form-control input-category" data-row="{{ row.index }}">
                    <option value="">{{ text_select }}</option>
                    {% for category in categories %}
                    <option value="{{ category.category_id }}"{% if category.category_id == row.category_id %} selected="selected"{% endif %}>{{ category.name }}</option>
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="col-sm-4">
                <div class="form-group">
                  <label>{{ entry_product }}</label>
                  <select name="module_hydrophob_info_block_rows[{{ row.index }}][product_id]" class="form-control input-product" data-row="{{ row.index }}" data-selected="{{ row.product_id }}">
                    <option value="">{{ text_select }}</option>
                  </select>
                </div>
              </div>
              
            </div>
            <div class="row">
              <div class="col-sm-3">
                <label>{{ entry_poster }}</label><br/>
                <span class="media-tile">
                  <a href="" id="thumb-row-{{ row.index }}-poster" data-toggle="image" class="img-thumbnail"><img src="{{ row.thumb_poster }}" alt="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="module_hydrophob_info_block_rows[{{ row.index }}][poster]" value="{{ row.poster }}" id="input-row-{{ row.index }}-poster" />
                  <a href="" data-toggle="video" data-video-input="input-row-{{ row.index }}-video" class="media-tile__play {% if row.video %}media-tile__play--on{% else %}media-tile__play--off{% endif %}" title="{{ row.video ?: 'Прикріпити відео' }}"><i class="fa fa-play"></i></a>
                  <button type="button" class="media-tile__clear-video"{% if not row.video %} style="display:none;"{% endif %} title="Прибрати відео">&times;</button>
                  <input type="hidden" data-role="video" name="module_hydrophob_info_block_rows[{{ row.index }}][video]" value="{{ row.video }}" id="input-row-{{ row.index }}-video" />
                </span>
              </div>
            </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>

      <div class="form-group">
        <label for="input-status">{{ entry_status }}</label>
        <select name="module_hydrophob_info_block_status" id="input-status" class="form-control" style="width:auto;display:inline-block;">
          <option value="1" {% if status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
          <option value="0" {% if not status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
        </select>
      </div>
    </form>
  </div>
</div>

<script>
var infoBlockProductsByCategory = {{ products_by_category_json|raw }};
var infoBlockRowNext = {{ next_row_index }};
var infoBlockTextSelect = '{{ text_select|escape('js') }}';

function infoBlockFillProductSelect(select, categoryId, selectedId) {
  select.innerHTML = '';
  var optNone = document.createElement('option');
  optNone.value = '';
  optNone.textContent = infoBlockTextSelect;
  select.appendChild(optNone);

  var list = infoBlockProductsByCategory[categoryId] || [];
  list.forEach(function(p) {
    var opt = document.createElement('option');
    opt.value = p.product_id;
    opt.textContent = p.name;
    if (String(p.product_id) === String(selectedId)) {
      opt.selected = true;
    }
    select.appendChild(opt);
  });
}

function infoBlockInitRow(row) {
  var categorySelect = row.querySelector('.input-category');
  var productSelect = row.querySelector('.input-product');
  if (!categorySelect || !productSelect) return;

  var selected = productSelect.dataset.selected || '';
  infoBlockFillProductSelect(productSelect, categorySelect.value, selected);

  categorySelect.addEventListener('change', function() {
    infoBlockFillProductSelect(productSelect, categorySelect.value, '');
  });

  var removeBtn = row.querySelector('.btn-remove-row');
  if (removeBtn) {
    removeBtn.addEventListener('click', function() {
      row.parentNode.removeChild(row);
    });
  }
}

document.querySelectorAll('#rows-list .hydro-row').forEach(infoBlockInitRow);

// Акордеон рядів
document.getElementById('rows-list').addEventListener('click', function (e) {
  if (e.target.closest('.btn-remove-row') || e.target.closest('a[data-toggle]') || e.target.closest('select')) return;
  var head = e.target.closest('.hydro-row__toggle');
  if (!head) return;
  head.closest('.hydro-row').classList.toggle('hydro-row--collapsed');
});

// Прев'ю в шапці = вибраний товар
document.getElementById('rows-list').addEventListener('change', function (e) {
  var sel = e.target.closest('.input-product');
  if (!sel) return;
  var prev = sel.closest('.hydro-row').querySelector('.hydro-row__preview');
  if (prev) prev.textContent = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].text : '';
});

// Відео-пікер (медіатека, filter_type=video)
function syncMediaTile(tile) {
  var input = tile.querySelector('input[data-role=video]');
  var play = tile.querySelector('.media-tile__play');
  var clear = tile.querySelector('.media-tile__clear-video');
  var has = !!input.value;
  play.classList.toggle('media-tile__play--on', has);
  play.classList.toggle('media-tile__play--off', !has);
  play.title = input.value || 'Прикріпити відео';
  if (clear) clear.style.display = has ? '' : 'none';
}
$(document).on('click', '.media-tile__clear-video', function () {
  var tile = this.closest('.media-tile');
  tile.querySelector('input[data-role=video]').value = '';
  syncMediaTile(tile);
});
$(document).on('hidden.bs.modal', '#modal-image', function () {
  document.querySelectorAll('.media-tile').forEach(function (tile) {
    syncMediaTile(tile);
    // Автопостер: якщо відео вибране, а постера нема — генеруємо кадр з відео (ffmpeg, детерміновано)
    var vid = tile.querySelector('input[data-role=video]');
    var posterInput = tile.querySelector('input[type=hidden]:not([data-role])');
    var img = tile.querySelector('.img-thumbnail img');
    if (vid.value && posterInput && !posterInput.value) {
      $.getJSON('index.php?route=common/video_poster&user_token={{ user_token }}&video=' + encodeURIComponent(vid.value), function (r) {
        if (r && r.poster) {
          posterInput.value = r.poster;
          if (img && r.thumb) img.src = r.thumb;
        }
      });
    }
  });
});
$(document).on('click', 'a[data-toggle="video"]', function (e) {
  e.preventDefault();
  var targetId = $(this).data('video-input');
  $('#modal-image').remove();
  $.ajax({
    url: 'index.php?route=common/filemanager&user_token={{ user_token }}&target=' + targetId + '&filter_type=video',
    dataType: 'html',
    success: function (html) {
      $('body').append('<div id="modal-image" class="modal">' + html + '</div>');
      $('#modal-image').modal('show');
    }
  });
});

// заповнити прев'ю при завантаженні
setTimeout(function () {
  document.querySelectorAll('#rows-list .hydro-row').forEach(function (row) {
    var sel = row.querySelector('.input-product');
    var prev = row.querySelector('.hydro-row__preview');
    if (sel && prev && sel.selectedIndex > 0) prev.textContent = sel.options[sel.selectedIndex].text;
  });
}, 300);


document.getElementById('btn-add-row').addEventListener('click', function() {
  var idx = infoBlockRowNext++;
  var wrap = document.createElement('div');
  wrap.innerHTML =
    '<div class="hydro-row" id="row-' + idx + '">' +
      '<div class="hydro-row__head hydro-row__toggle"><i class="fa fa-chevron-down hydro-row__chevron"></i><strong>{{ entry_row|escape('js') }}</strong><span class="hydro-row__preview"></span><button type="button" class="btn btn-danger btn-sm btn-remove-row"><i class="fa fa-minus-circle"></i></button></div>' +
      '<div class="hydro-row__body">' +
      '<div class="row">' +
        '<div class="col-sm-4"><div class="form-group"><label>{{ entry_category|escape('js') }}</label><select name="module_hydrophob_info_block_rows[' + idx + '][category_id]" class="form-control input-category" data-row="' + idx + '"><option value="">' + infoBlockTextSelect + '</option>' +
        {% for category in categories %}
        '<option value="{{ category.category_id }}">{{ category.name|escape('js') }}</option>' +
        {% endfor %}
        '</select></div></div>' +
        '<div class="col-sm-4"><div class="form-group"><label>{{ entry_product|escape('js') }}</label><select name="module_hydrophob_info_block_rows[' + idx + '][product_id]" class="form-control input-product" data-row="' + idx + '" data-selected=""><option value="">' + infoBlockTextSelect + '</option></select></div></div>' +
        
      '</div>' +
      '<div class="row">' +
        '<div class="col-sm-3"><label>{{ entry_poster|escape('js') }}</label><br/><a href="" id="thumb-row-' + idx + '-poster" data-toggle="image" class="img-thumbnail"><img src="{{ placeholder }}" alt="" data-placeholder="{{ placeholder }}" style="max-width:160px;" /></a><input type="hidden" name="module_hydrophob_info_block_rows[' + idx + '][poster]" value="" id="input-row-' + idx + '-poster" /></div>' +
      '</div>' +
    '</div>' +
    '</div>';

  var row = wrap.firstElementChild;
  document.getElementById('rows-list').appendChild(row);
  infoBlockInitRow(row);
});
</script>

<style>
.hydro-repeater { background: #f7f9fc; border: 1px solid #dfe6f1; border-radius: 10px; padding: 14px; margin-bottom: 14px; }
.hydro-repeater__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 10px; }
.hydro-repeater__head h4 { margin: 0; }
.hydro-row { background: #fff; border: 1px solid #e4eaf3; border-radius: 8px; margin-bottom: 10px; padding: 12px; }
.hydro-row__toggle { cursor: pointer; gap: 10px; user-select: none; }
.hydro-row__toggle .btn-remove-row { margin-left: auto; }
.hydro-row__chevron { color: #7f96ad; font-size: 12px; transition: transform .18s ease; }
.hydro-row:not(.hydro-row--collapsed) .hydro-row__chevron { transform: rotate(90deg); }
.hydro-row__preview { color: #8fa2b5; flex: 1; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hydro-row--collapsed .hydro-row__body { display: none; }
.hydro-row--collapsed { padding-bottom: 8px; }
.media-tile { display: inline-block; position: relative; }
.media-tile .img-thumbnail { display: block; margin: 0; padding: 2px; }
.media-tile .img-thumbnail img { display: block; height: 96px; object-fit: cover; width: 96px; }
.media-tile__play { align-items: center; border-radius: 50%; color: #fff; cursor: pointer; display: flex; font-size: 13px; justify-content: center; position: absolute; z-index: 2; }
.media-tile__play--off { background: rgba(18,18,18,.45); bottom: 7px; height: 24px; right: 7px; width: 24px; }
.media-tile__play--on { background: #1D9CB2; bottom: 7px; font-size: 14px; height: 28px; right: 7px; width: 28px; }
.media-tile__play--on:hover, .media-tile__play--off:hover { background: #1D9CB2; color: #fff; }
.media-tile__play i { margin-left: 2px; }
.media-tile__clear-video { background: #fff; border: 1px solid #e3b3b3; border-radius: 50%; color: #c66; cursor: pointer; font-size: 13px; height: 22px; line-height: 1; padding: 0; position: absolute; right: -7px; top: -7px; width: 22px; z-index: 3; }
.hydro-row__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 8px; }
</style>

{{ footer }}
