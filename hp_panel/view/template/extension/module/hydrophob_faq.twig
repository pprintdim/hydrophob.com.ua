{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">

          <div class="hydro-card">
            <div class="hydro-card__title">{{ entry_title_html }}</div>
            <ul class="nav nav-tabs hydro-tabs">
              {% for language in languages %}
              <li{% if loop.first %} class="active"{% endif %}><a href="#faq-title{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
              {% endfor %}
            </ul>
            <div class="tab-content hydro-tab-content">
              {% for language in languages %}
              <div class="tab-pane{% if loop.first %} active{% endif %}" id="faq-title{{ language.language_id }}">
                <input type="text" name="module_hydrophob_faq_title_html[{{ language.language_id }}]" value="{{ title_html[language.language_id] is defined ? title_html[language.language_id] : '' }}" class="form-control" />
              </div>
              {% endfor %}
            </div>
          </div>

          <div class="hydro-repeater">
            <div class="hydro-repeater__head">
              <h4>{{ entry_items }}</h4>
              <button type="button" id="btn-add-faq" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> {{ entry_add }}</button>
            </div>
            <div id="faq-body">
              {% for i, item in items %}
              <div class="hydro-row" id="faq-row{{ i }}">
                <div class="hydro-row__head">
                  <strong>{{ entry_item }}</strong>
                  <button type="button" class="btn btn-danger btn-sm btn-remove-faq"><i class="fa fa-minus-circle"></i></button>
                </div>

                <div class="hydro-card">
                  <div class="hydro-card__title">{{ entry_question }}</div>
                  <ul class="nav nav-tabs hydro-tabs">
                    {% for language in languages %}
                    <li{% if loop.first %} class="active"{% endif %}><a href="#faq{{ i }}-q{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
                    {% endfor %}
                  </ul>
                  <div class="tab-content hydro-tab-content">
                    {% for language in languages %}
                    <div class="tab-pane{% if loop.first %} active{% endif %}" id="faq{{ i }}-q{{ language.language_id }}">
                      <input type="text" name="module_hydrophob_faq_items[{{ i }}][question][{{ language.language_id }}]" value="{{ item.question[language.language_id] is defined ? item.question[language.language_id] : '' }}" class="form-control" />
                    </div>
                    {% endfor %}
                  </div>
                </div>

                <div class="hydro-card">
                  <div class="hydro-card__title">{{ entry_answer }}</div>
                  <ul class="nav nav-tabs hydro-tabs">
                    {% for language in languages %}
                    <li{% if loop.first %} class="active"{% endif %}><a href="#faq{{ i }}-a{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
                    {% endfor %}
                  </ul>
                  <div class="tab-content hydro-tab-content">
                    {% for language in languages %}
                    <div class="tab-pane{% if loop.first %} active{% endif %}" id="faq{{ i }}-a{{ language.language_id }}">
                      <textarea name="module_hydrophob_faq_items[{{ i }}][answer][{{ language.language_id }}]" rows="3" class="form-control">{{ item.answer[language.language_id] is defined ? item.answer[language.language_id] : '' }}</textarea>
                    </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
              {% endfor %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_hydrophob_faq_status" id="input-status" class="form-control">
                <option value="1" {% if status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<script>
var faqRowIndex = {{ next_index }};
var faqLangs = [
{% for language in languages %}
  { id: {{ language.language_id }}, name: '{{ language.name|escape('js') }}' }{% if not loop.last %},{% endif %}
{% endfor %}
];

function faqLangTabs(prefix) {
  var tabsHtml = '<ul class="nav nav-tabs hydro-tabs">';
  var contentHtml = '<div class="tab-content hydro-tab-content">';
  for (var i = 0; i < faqLangs.length; i++) {
    var active = i === 0 ? ' active' : '';
    tabsHtml += '<li class="' + active.trim() + '"><a href="#' + prefix + faqLangs[i].id + '" data-toggle="tab">' + faqLangs[i].name + '</a></li>';
    var field = prefix.indexOf('-a') !== -1
      ? '<textarea name="module_hydrophob_faq_items[' + faqRowIndex + '][answer][' + faqLangs[i].id + ']" rows="3" class="form-control"></textarea>'
      : '<input type="text" name="module_hydrophob_faq_items[' + faqRowIndex + '][question][' + faqLangs[i].id + ']" class="form-control" />';
    contentHtml += '<div class="tab-pane' + active + '" id="' + prefix + faqLangs[i].id + '">' + field + '</div>';
  }
  tabsHtml += '</ul>';
  contentHtml += '</div>';
  return tabsHtml + contentHtml;
}

document.getElementById('btn-add-faq').addEventListener('click', function() {
  var list = document.getElementById('faq-body');
  var row = document.createElement('div');
  row.className = 'hydro-row';
  row.id = 'faq-row' + faqRowIndex;

  row.innerHTML =
    '<div class="hydro-row__head"><strong>{{ entry_item|escape('js') }}</strong><button type="button" class="btn btn-danger btn-sm btn-remove-faq"><i class="fa fa-minus-circle"></i></button></div>' +
    '<div class="hydro-card"><div class="hydro-card__title">{{ entry_question|escape('js') }}</div>' + faqLangTabs('faq' + faqRowIndex + '-q') + '</div>' +
    '<div class="hydro-card"><div class="hydro-card__title">{{ entry_answer|escape('js') }}</div>' + faqLangTabs('faq' + faqRowIndex + '-a') + '</div>';

  list.appendChild(row);
  faqRowIndex++;

  row.querySelector('.btn-remove-faq').addEventListener('click', function() {
    row.parentNode.removeChild(row);
  });
});

document.querySelectorAll('.btn-remove-faq').forEach(function(btn) {
  btn.addEventListener('click', function() {
    btn.closest('.hydro-row').remove();
  });
});
</script>

<style>
.hydro-card { background: linear-gradient(180deg, #fff 0%, #f8fbff 100%); border: 1px solid #dfe6f1; border-radius: 10px; margin-bottom: 14px; padding: 14px; }
.hydro-card__title { color: #36506b; font-size: 12px; font-weight: 700; letter-spacing: .04em; margin-bottom: 9px; text-transform: uppercase; }
.hydro-tabs { border-bottom: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.hydro-tabs > li { float: none; margin: 0; }
.hydro-tabs > li > a { background: #f7fafc; border: 1px solid #d9e4ef; border-radius: 999px; color: #4b627b; padding: 6px 10px; }
.hydro-tabs > li.active > a, .hydro-tabs > li.active > a:hover, .hydro-tabs > li.active > a:focus { background: #e9f4ff; border-color: #acd1f1; color: #1f5d95; }
.hydro-tab-content .form-control { border-color: #d7e3ef; border-radius: 10px; box-shadow: none; }
.hydro-repeater { background: #f7f9fc; border: 1px solid #dfe6f1; border-radius: 10px; padding: 14px; margin-bottom: 14px; }
.hydro-repeater__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 10px; }
.hydro-repeater__head h4 { margin: 0; }
.hydro-row { background: #fff; border: 1px solid #e4eaf3; border-radius: 8px; margin-bottom: 10px; padding: 12px; }
.hydro-row__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 8px; }
</style>

{{ footer }}
