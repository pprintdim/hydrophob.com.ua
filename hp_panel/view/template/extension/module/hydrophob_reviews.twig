{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-module" class="form-horizontal">

          <div class="hydro-card">
            <div class="hydro-card__title">{{ entry_title_html }}</div>
            <ul class="nav nav-tabs hydro-tabs">
              {% for language in languages %}
              <li{% if loop.first %} class="active"{% endif %}><a href="#reviews-title{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
              {% endfor %}
            </ul>
            <div class="tab-content hydro-tab-content">
              {% for language in languages %}
              <div class="tab-pane{% if loop.first %} active{% endif %}" id="reviews-title{{ language.language_id }}">
                <input type="text" name="module_hydrophob_reviews_title_html[{{ language.language_id }}]" value="{{ title_html[language.language_id] is defined ? title_html[language.language_id] : '' }}" class="form-control" />
              </div>
              {% endfor %}
            </div>
          </div>

          <div class="hydro-repeater">
            <div class="hydro-repeater__head">
              <h4>{{ entry_items }}</h4>
              <button type="button" id="btn-add-review" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> {{ entry_add }}</button>
            </div>
            <div id="reviews-body">
              {% for i, item in items %}
              <div class="hydro-row hydro-row--collapsed" id="review-row{{ i }}">
                <div class="hydro-row__head hydro-row__toggle">
                  <i class="fa fa-chevron-right hydro-row__chevron"></i>
                  <strong>{{ entry_item }} {{ i + 1 }}</strong>
                  <span class="hydro-row__preview">{{ item.message[2] is defined ? item.message[2]|striptags|slice(0, 60) : '' }}</span>
                  <button type="button" class="btn btn-danger btn-sm btn-remove-review"><i class="fa fa-minus-circle"></i></button>
                </div>
                <div class="row hydro-row__body">
                  <div class="col-sm-3">
                    <span class="media-tile">
                          <a href="" id="thumb-review{{ i }}" data-toggle="image" class="img-thumbnail"><img src="{{ item.thumb_poster }}" alt="" data-placeholder="{{ placeholder }}" /></a>
                          <input type="hidden" name="module_hydrophob_reviews_items[{{ i }}][poster]" value="{{ item.poster }}" id="input-review{{ i }}" />
                          <a href="" data-toggle="video" data-video-input="input-review-video{{ i }}" class="media-tile__play {% if item.video %}media-tile__play--on{% else %}media-tile__play--off{% endif %}" title="{{ item.video ?: 'Прикріпити відео' }}"><i class="fa fa-play"></i></a>
                          <button type="button" class="media-tile__clear-video"{% if not item.video %} style="display:none;"{% endif %} title="Прибрати відео">&times;</button>
                          <input type="hidden" data-role="video" name="module_hydrophob_reviews_items[{{ i }}][video]" value="{{ item.video }}" id="input-review-video{{ i }}" />
                        </span>
                  </div>
                  <div class="col-sm-9">
                    <div class="hydro-card">
                      <div class="hydro-card__title">Заголовок та альт тексти</div>
                      <ul class="nav nav-tabs hydro-tabs">
                        {% for language in languages %}
                        <li{% if loop.first %} class="active"{% endif %}><a href="#review{{ i }}-txt{{ language.language_id }}" data-toggle="tab">{{ language.name }}</a></li>
                        {% endfor %}
                      </ul>
                      <div class="tab-content hydro-tab-content">
                        {% for language in languages %}
                        <div class="tab-pane{% if loop.first %} active{% endif %}" id="review{{ i }}-txt{{ language.language_id }}">
                          <div style="display:flex; gap:8px;">
                            <input type="text" name="module_hydrophob_reviews_items[{{ i }}][message][{{ language.language_id }}]" value="{{ item.message[language.language_id] is defined ? item.message[language.language_id] : '' }}" placeholder="{{ entry_message }}" class="form-control" style="flex:1;" />
                            <input type="text" name="module_hydrophob_reviews_items[{{ i }}][alt][{{ language.language_id }}]" value="{{ item.alt[language.language_id] is defined ? item.alt[language.language_id] : '' }}" placeholder="{{ entry_alt }}" class="form-control" style="flex:1;" />
                          </div>
                        </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              {% endfor %}
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_hydrophob_reviews_status" id="input-status" class="form-control">
                <option value="1" {% if status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>

<script>
var reviewRowIndex = {{ next_index }};
var reviewLangs = [
{% for language in languages %}
  { id: {{ language.language_id }}, name: '{{ language.name|escape('js') }}' }{% if not loop.last %},{% endif %}
{% endfor %}
];
var reviewPlaceholder = '{{ placeholder|escape('js') }}';

function reviewLangTabs(prefix, kind) {
  var tabsHtml = '<ul class="nav nav-tabs hydro-tabs">';
  var contentHtml = '<div class="tab-content hydro-tab-content">';
  for (var i = 0; i < reviewLangs.length; i++) {
    var active = i === 0 ? ' active' : '';
    tabsHtml += '<li class="' + active.trim() + '"><a href="#' + prefix + reviewLangs[i].id + '" data-toggle="tab">' + reviewLangs[i].name + '</a></li>';
    var field;
    if (kind === 'merged') {
      field = '<div style="display:flex;gap:8px;">' +
        '<input type="text" name="module_hydrophob_reviews_items[' + reviewRowIndex + '][message][' + reviewLangs[i].id + ']" placeholder="{{ entry_message|escape('js') }}" class="form-control" style="flex:1;" />' +
        '<input type="text" name="module_hydrophob_reviews_items[' + reviewRowIndex + '][alt][' + reviewLangs[i].id + ']" placeholder="{{ entry_alt|escape('js') }}" class="form-control" style="flex:1;" />' +
        '</div>';
    } else if (kind === 'message') {
      field = '<textarea name="module_hydrophob_reviews_items[' + reviewRowIndex + '][message][' + reviewLangs[i].id + ']" rows="3" class="form-control"></textarea>';
    } else {
      field = '<input type="text" name="module_hydrophob_reviews_items[' + reviewRowIndex + '][alt][' + reviewLangs[i].id + ']" class="form-control" />';
    }
    contentHtml += '<div class="tab-pane' + active + '" id="' + prefix + reviewLangs[i].id + '">' + field + '</div>';
  }
  tabsHtml += '</ul>';
  contentHtml += '</div>';
  return tabsHtml + contentHtml;
}


// Акордеон рядів (початково згорнуто; клік по шапці розгортає)
document.getElementById('reviews-body').addEventListener('click', function (e) {
  if (e.target.closest('.btn-remove-review') || e.target.closest('a[data-toggle]')) return;
  var head = e.target.closest('.hydro-row__toggle');
  if (!head) return;
  head.closest('.hydro-row').classList.toggle('hydro-row--collapsed');
});


// Стан відео-пікера: бірюзовий значок коли відео вибране, хрестик прибирає
function syncMediaTile(tile) {
  var input = tile.querySelector('input[data-role=video]');
  var play = tile.querySelector('.media-tile__play');
  var clear = tile.querySelector('.media-tile__clear-video');
  var has = !!input.value;
  play.classList.toggle('media-tile__play--on', has);
  play.classList.toggle('media-tile__play--off', !has);
  play.title = input.value || 'Прикріпити відео';
  if (clear) clear.style.display = has ? '' : 'none';
}
$(document).on('click', '.media-tile__clear-video', function () {
  var tile = this.closest('.media-tile');
  tile.querySelector('input[data-role=video]').value = '';
  syncMediaTile(tile);
});
$(document).on('hidden.bs.modal', '#modal-image', function () {
  document.querySelectorAll('.media-tile').forEach(function (tile) {
    syncMediaTile(tile);
    // Автопостер: якщо відео вибране, а постера нема — генеруємо кадр з відео (ffmpeg, детерміновано)
    var vid = tile.querySelector('input[data-role=video]');
    var posterInput = tile.querySelector('input[type=hidden]:not([data-role])');
    var img = tile.querySelector('.img-thumbnail img');
    if (vid.value && posterInput && !posterInput.value) {
      $.getJSON('index.php?route=common/video_poster&user_token={{ user_token }}&video=' + encodeURIComponent(vid.value), function (r) {
        if (r && r.poster) {
          posterInput.value = r.poster;
          if (img && r.thumb) img.src = r.thumb;
        }
      });
    }
  });
});

// Вибір відео з медіатеки (filemanager з filter_type=video)
$(document).on('click', 'a[data-toggle="video"]', function (e) {
  e.preventDefault();
  var targetId = $(this).data('video-input');
  $('#modal-image').remove();
  $.ajax({
    url: 'index.php?route=common/filemanager&user_token={{ user_token }}&target=' + targetId + '&filter_type=video',
    dataType: 'html',
    success: function (html) {
      $('body').append('<div id="modal-image" class="modal">' + html + '</div>');
      $('#modal-image').modal('show');
    }
  });
});

document.getElementById('btn-add-review').addEventListener('click', function() {
  var list = document.getElementById('reviews-body');
  var row = document.createElement('div');
  row.className = 'hydro-row';  // новий ряд одразу розгорнутий
  row.id = 'review-row' + reviewRowIndex;

  row.innerHTML =
    '<div class="hydro-row__head hydro-row__toggle"><i class="fa fa-chevron-down hydro-row__chevron"></i><strong>{{ entry_item|escape('js') }} ' + (reviewRowIndex + 1) + '</strong><span class="hydro-row__preview"></span><button type="button" class="btn btn-danger btn-sm btn-remove-review"><i class="fa fa-minus-circle"></i></button></div>' +
    '<div class="row hydro-row__body">' +
      '<div class="col-sm-3">' +
        '<span class="media-tile">' +
          '<a href="" id="thumb-review' + reviewRowIndex + '" data-toggle="image" class="img-thumbnail"><img src="' + reviewPlaceholder + '" alt="" data-placeholder="' + reviewPlaceholder + '" /></a>' +
          '<input type="hidden" name="module_hydrophob_reviews_items[' + reviewRowIndex + '][poster]" value="" id="input-review' + reviewRowIndex + '" />' +
          '<a href="" data-toggle="video" data-video-input="input-review-video' + reviewRowIndex + '" class="media-tile__play media-tile__play--off" title="Прикріпити відео"><i class="fa fa-play"></i></a>' +
          '<button type="button" class="media-tile__clear-video" style="display:none;">&times;</button>' +
          '<input type="hidden" data-role="video" name="module_hydrophob_reviews_items[' + reviewRowIndex + '][video]" id="input-review-video' + reviewRowIndex + '" value="" /></span>' +
      '</div>' +
      '<div class="col-sm-9">' +
        '<div class="hydro-card"><div class="hydro-card__title">Заголовок та альт тексти</div>' + reviewLangTabs('review' + reviewRowIndex + '-txt', 'merged') + '</div>' +
      '</div>' +
    '</div>';

  list.appendChild(row);
  reviewRowIndex++;

  row.querySelector('.btn-remove-review').addEventListener('click', function() {
    row.parentNode.removeChild(row);
  });
});

document.querySelectorAll('.btn-remove-review').forEach(function(btn) {
  btn.addEventListener('click', function() {
    btn.closest('.hydro-row').remove();
  });
});
</script>

<style>
.hydro-card { background: linear-gradient(180deg, #fff 0%, #f8fbff 100%); border: 1px solid #dfe6f1; border-radius: 10px; margin-bottom: 14px; padding: 14px; }
.hydro-card__title { color: #36506b; font-size: 12px; font-weight: 700; letter-spacing: .04em; margin-bottom: 9px; text-transform: uppercase; }
.hydro-tabs { border-bottom: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
.hydro-tabs > li { float: none; margin: 0; }
.hydro-tabs > li > a { background: #f7fafc; border: 1px solid #d9e4ef; border-radius: 999px; color: #4b627b; padding: 6px 10px; }
.hydro-tabs > li.active > a, .hydro-tabs > li.active > a:hover, .hydro-tabs > li.active > a:focus { background: #e9f4ff; border-color: #acd1f1; color: #1f5d95; }
.hydro-tab-content .form-control { border-color: #d7e3ef; border-radius: 10px; box-shadow: none; }
.hydro-repeater { background: #f7f9fc; border: 1px solid #dfe6f1; border-radius: 10px; padding: 14px; margin-bottom: 14px; }
.hydro-repeater__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 10px; }
.hydro-repeater__head h4 { margin: 0; }
.hydro-row { background: #fff; border: 1px solid #e4eaf3; border-radius: 8px; margin-bottom: 10px; padding: 12px; }
.hydro-row__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 8px; }
</style>


<style>
.media-tile { display: inline-block; position: relative; }
.media-tile .img-thumbnail { display: block; margin: 0; padding: 2px; }
.media-tile .img-thumbnail img { display: block; height: 96px; object-fit: cover; width: 96px; }
.media-tile__play { align-items: center; border-radius: 50%; color: #fff; cursor: pointer; display: flex; font-size: 13px; justify-content: center; position: absolute; z-index: 2; }
.media-tile__play--off { background: rgba(18,18,18,.45); bottom: 7px; height: 24px; right: 7px; width: 24px; }
.media-tile__play--on { background: #1D9CB2; bottom: 7px; font-size: 14px; height: 28px; right: 7px; width: 28px; }
.media-tile__play--on:hover, .media-tile__play--off:hover { background: #1D9CB2; color: #fff; }
.media-tile__play i { margin-left: 2px; }
.media-tile__clear-video { background: #fff; border: 1px solid #e3b3b3; border-radius: 50%; color: #c66; cursor: pointer; font-size: 13px; height: 22px; line-height: 1; padding: 0; position: absolute; right: -7px; top: -7px; width: 22px; z-index: 3; }
.hydro-row__toggle { align-items: center; cursor: pointer; display: flex; gap: 10px; user-select: none; }
.hydro-row__chevron { color: #7f96ad; font-size: 12px; transition: transform .18s ease; }
.hydro-row:not(.hydro-row--collapsed) .hydro-row__chevron { transform: rotate(90deg); }
.hydro-row__preview { color: #8fa2b5; flex: 1; font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hydro-row--collapsed .hydro-row__body { display: none; }
.hydro-row__toggle .btn-remove-review { margin-left: auto; }
</style>
{{ footer }}
