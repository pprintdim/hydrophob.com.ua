{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-seo" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-seo">
      {# один глобальний перемикач мов на всю форму (стандарт адмін-форм) #}
      <ul class="nav nav-tabs seo-langs" style="margin-bottom: 15px;">
        {% for lang in langs %}
        <li{% if loop.first %} class="active"{% endif %}><a href="#" data-seo-lang="{{ lang }}">{{ lang }}</a></li>
        {% endfor %}
      </ul>
      {% set page_titles = {'home': text_page_home, 'checkout': text_page_checkout, 'error': text_page_error} %}
      {% for page, page_meta in pages %}
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title"><i class="fa fa-search"></i> {{ page_titles[page] }}</h3>
        </div>
        <div class="panel-body">
          {% for lang in langs %}
          <div class="seo-lang-fields seo-lang-{{ lang }}"{% if not loop.first %} style="display: none;"{% endif %}>
            <div class="form-group{% if page == 'home' %} required{% endif %}">
              <label class="col-sm-2 control-label">{{ entry_title }}</label>
              <div class="col-sm-10">
                <input type="text" name="pages[{{ page }}][{{ lang }}][title]" value="{{ page_meta[lang].title }}" class="form-control" maxlength="255" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_description }}</label>
              <div class="col-sm-10">
                <textarea name="pages[{{ page }}][{{ lang }}][description]" rows="2" class="form-control" maxlength="500">{{ page_meta[lang].description }}</textarea>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">{{ entry_keywords }}</label>
              <div class="col-sm-10">
                <input type="text" name="pages[{{ page }}][{{ lang }}][keywords]" value="{{ page_meta[lang].keywords }}" class="form-control" />
              </div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title"><i class="fa fa-bar-chart"></i> {{ text_analytics }}</h3>
        </div>
        <div class="panel-body">
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_ga4 }}</label>
            <div class="col-sm-10">
              <input type="text" name="ga4_id" value="{{ ga4_id }}" placeholder="G-XXXXXXXXXX" class="form-control" />
              <p class="help-block">{{ help_ga4 }}</p>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
<script type="text/javascript"><!--
$('.seo-langs a').on('click', function(e) {
	e.preventDefault();
	$('.seo-langs li').removeClass('active');
	$(this).parent().addClass('active');
	$('.seo-lang-fields').hide();
	$('.seo-lang-' + $(this).data('seo-lang')).show();
});
//--></script>
{{ footer }}
