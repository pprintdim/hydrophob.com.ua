  //--></script>
  <script type="text/javascript"><!--
  $('#language a:first').tab('show');
  $('#option a:first').tab('show');
  //--></script>

  <script type="text/javascript">
  var productLandLangs = [
  {% for language in languages %}
    { id: {{ language.language_id }}, name: '{{ language.name|escape('js') }}' }{% if not loop.last %},{% endif %}
  {% endfor %}
  ];

  function productLandTabs(prefix, idx, kind) {
    var tabsHtml = '<ul class="nav nav-tabs hydro-tabs">';
    var contentHtml = '<div class="tab-content hydro-tab-content">';
    for (var i = 0; i < productLandLangs.length; i++) {
      var active = i === 0 ? ' active' : '';
      tabsHtml += '<li class="' + active.trim() + '"><a href="#' + prefix + productLandLangs[i].id + '" data-toggle="tab">' + productLandLangs[i].name + '</a></li>';
      var field = kind === 'html'
        ? '<textarea name="product_land[blocks][' + idx + '][html][' + productLandLangs[i].id + ']" rows="5" class="form-control"></textarea>'
        : '<input type="text" name="product_land[blocks][' + idx + '][title][' + productLandLangs[i].id + ']" class="form-control" />';
      contentHtml += '<div class="tab-pane' + active + '" id="' + prefix + productLandLangs[i].id + '">' + field + '</div>';
    }
    tabsHtml += '</ul>';
    contentHtml += '</div>';
    return tabsHtml + contentHtml;
  }

  document.getElementById('btn-add-land-block').addEventListener('click', function() {
    var btn = this;
    var idx = parseInt(btn.dataset.next, 10);
    var list = document.getElementById('land-blocks-list');
    var row = document.createElement('div');
    row.className = 'hydro-row';
    row.id = 'land-block-' + idx;

    row.innerHTML =
      '<div class="hydro-row__head"><strong>{{ entry_land_block|escape('js') }}</strong><button type="button" class="btn btn-danger btn-sm btn-remove-land-block"><i class="fa fa-minus-circle"></i></button></div>' +
      '<div class="hydro-card"><div class="hydro-card__title">{{ entry_land_block_title|escape('js') }}</div>' + productLandTabs('land-b' + idx + '-title', idx, 'title') + '</div>' +
      '<div class="hydro-card"><div class="hydro-card__title">{{ entry_land_block_html|escape('js') }}</div>' + productLandTabs('land-b' + idx + '-html', idx, 'html') + '</div>';

    list.appendChild(row);
    btn.dataset.next = idx + 1;

    row.querySelector('.btn-remove-land-block').addEventListener('click', function() {
      row.parentNode.removeChild(row);
    });
  });

  document.querySelectorAll('.btn-remove-land-block').forEach(function(btn) {
    btn.addEventListener('click', function() {
      btn.closest('.hydro-row').remove();
    });
  });
  </script>

  <style>
  .hydro-card { background: linear-gradient(180deg, #fff 0%, #f8fbff 100%); border: 1px solid #dfe6f1; border-radius: 10px; margin-bottom: 14px; padding: 14px; }
  .hydro-card__title { color: #36506b; font-size: 12px; font-weight: 700; letter-spacing: .04em; margin-bottom: 9px; text-transform: uppercase; }
  .hydro-tabs { border-bottom: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
  .hydro-tabs > li { float: none; margin: 0; }
  .hydro-tabs > li > a { background: #f7fafc; border: 1px solid #d9e4ef; border-radius: 999px; color: #4b627b; padding: 6px 10px; }
  .hydro-tabs > li.active > a, .hydro-tabs > li.active > a:hover, .hydro-tabs > li.active > a:focus { background: #e9f4ff; border-color: #acd1f1; color: #1f5d95; }
  .hydro-tab-content .form-control { border-color: #d7e3ef; border-radius: 10px; box-shadow: none; }
  .hydro-repeater { background: #f7f9fc; border: 1px solid #dfe6f1; border-radius: 10px; padding: 14px; margin-bottom: 14px; }
  .hydro-repeater__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 10px; }
  .hydro-repeater__head h4 { margin: 0; }
  .hydro-row { background: #fff; border: 1px solid #e4eaf3; border-radius: 8px; margin-bottom: 10px; padding: 12px; }
  .hydro-row__head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 8px; }
  </style>
</div>

