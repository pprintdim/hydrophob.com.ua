{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-information" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-file-text-o"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-information">
          <ul class="nav nav-tabs">
            {% for key, page in pages %}
            <li{% if loop.first %} class="active"{% endif %}><a href="#page-{{ key }}" data-toggle="tab">{{ page.label }}</a></li>
            {% endfor %}
          </ul>
          <div class="tab-content">
            {% for key, page in pages %}
            <div class="tab-pane{% if loop.first %} active{% endif %}" id="page-{{ key }}">
              <div class="form-group required">
                <label class="col-sm-2 control-label">{{ entry_title }}</label>
                <div class="col-sm-10">
                  <input type="text" name="pages[{{ key }}][title]" value="{{ page.title }}" class="form-control" />
                  <p class="help-block"><a href="{{ page.url }}" target="_blank">hydrophob.net.ua{{ page.url }}</a></p>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_content }}</label>
                <div class="col-sm-10">
                  <textarea name="pages[{{ key }}][html]" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ page.html }}</textarea>
                </div>
              </div>
            </div>
            {% endfor %}
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
