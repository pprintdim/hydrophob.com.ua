$('select[name=\'config_theme\']').on('change', function() {
	$.ajax({
		url: 'index.php?route=setting/setting/theme&user_token={{ user_token }}&theme=' + this.value,
		dataType: 'html',
		beforeSend: function() {
			$('select[name=\'config_theme\']').prop('disabled', true);
		},
		complete: function() {
			$('select[name=\'config_theme\']').prop('disabled', false);
		},
		success: function(html) {
			$('#theme').attr('src', html);
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('select[name=\'config_theme\']').trigger('change');
//--></script> 
  <script type="text/javascript"><!--
$('select[name=\'config_country_id\']').on('change', function() {
	$.ajax({
		url: 'index.php?route=localisation/country/country&user_token={{ user_token }}&country_id=' + this.value,
		dataType: 'json',
		beforeSend: function() {
			$('select[name=\'config_country_id\']').prop('disabled', true);
		},
		complete: function() {
			$('select[name=\'config_country_id\']').prop('disabled', false);
		},
		success: function(json) {
			html = '<option value="">{{ text_select }}</option>';

			if (json['zone'] && json['zone'] != '') {
				for (i = 0; i < json['zone'].length; i++) {
          			html += '<option value="' + json['zone'][i]['zone_id'] + '"';

					if (json['zone'][i]['zone_id'] == '{{ config_zone_id }}') {
            			html += ' selected="selected"';
					}

					html += '>' + json['zone'][i]['name'] + '</option>';
				}
			} else {
				html += '<option value="0" selected="selected">{{ text_none }}</option>';
			}

			$('select[name=\'config_zone_id\']').html(html);
			
			$('#button-save').prop('disabled', false);
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('select[name=\'config_country_id\']').trigger('change');
//--></script></div>

<script type="text/javascript"><!--
// Поштовий рушій: показуємо лише свої поля, чужі — ховаємо і зачищаємо
(function () {
  var engine = document.getElementById('input-mail-engine');
  if (!engine) return;
  var groups = {
    parameter: document.getElementById('input-mail-parameter'),
    smtp: ['input-mail-smtp-hostname', 'input-mail-smtp-username', 'input-mail-smtp-password', 'input-mail-smtp-port', 'input-mail-smtp-timeout']
      .map(function (id) { return document.getElementById(id); }),
  };
  var paramLabel = groups.parameter ? groups.parameter.closest('.form-group').querySelector('label') : null;
  function fg(el) { return el ? el.closest('.form-group') : null; }
  function sync(clear) {
    var mode = engine.value;
    var showParam = (mode === 'brevo' || mode === 'mail');
    var showSmtp = (mode === 'smtp');
    var pg = fg(groups.parameter);
    if (pg) {
      pg.style.display = showParam ? '' : 'none';
      if (!showParam && clear) groups.parameter.value = '';
      if (paramLabel) paramLabel.textContent = (mode === 'brevo') ? 'Brevo API ключ' : paramLabel.dataset.orig || paramLabel.textContent;
      if (!paramLabel.dataset.orig) paramLabel.dataset.orig = paramLabel.textContent;
    }
    groups.smtp.forEach(function (el) {
      var g = fg(el);
      if (!g) return;
      g.style.display = showSmtp ? '' : 'none';
      if (!showSmtp && clear) el.value = '';
    });
  }
  engine.addEventListener('change', function () { sync(true); });
  sync(false); // при завантаженні — тільки ховаємо, значення не чіпаємо
})();
//--></script>
